# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-key-here

# Any model listed on https://openrouter.ai/models
# Use a model that supports structured JSON output reliably.
OPENROUTER_MODEL=google/gemini-3.5-flash

# Low temperature for factual structured extraction (0.0–2.0)
OPENROUTER_TEMPERATURE=0.1

# Stronger model for one-shot dispute wrap-up (optional; uses same API key)
OPENROUTER_WRAPUP_MODEL=anthropic/claude-sonnet-4
OPENROUTER_WRAPUP_TEMPERATURE=0.1
